{
  "name": "wonderturn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "audio:bundle": "node scripts/generate-fixed-audio.mjs --bundle-only",
    "audio:fixed": "node scripts/generate-fixed-audio.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'eval/**/*.live.test.ts'",
    "test:live": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run eval/live-outcomes.live.test.ts --maxWorkers=1",
    "register": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run eval/register.live.test.ts --maxWorkers=1 --disableConsoleIntercept",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.28",
    "@fontsource-variable/literata": "^5.3.0",
    "ai": "^7.0.37",
    "better-auth": "1.6.25",
    "bowser": "^2.14.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
